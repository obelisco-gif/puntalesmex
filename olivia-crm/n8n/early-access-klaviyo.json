        "jsCode": "const j=$('Validar permiso y estado remoto').item.json;\nreturn {json:{...j,success:$json.statusCode===202,status:$json.statusCode===202?'completed':'failed',error:$json.statusCode===202?'':JSON.stringify($json.body?.errors??$json.error??'Error de baja').slice(0,1200),result:{unsubscribe_request_accepted:$json.statusCode===202}}};"
      }
