    {
      "id": "fdb301ca-338a-4422-9691-676130e5092b",
      "name": "Confirmar alta o esperar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        416
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j=$('Validar permiso y estado remoto').item.json;\nlet submitted=j.already_requested;\nlet submitError='';\ntry{const a=$('Registrar aceptación de solicitud').item.json;submitted=submitted||a.request_accepted;submitError=a.error??'';}catch{}\nconst success=$json.statusCode===200&&($json.body?.data??[]).some(l=>l.id===j.list_id);\nconst status=success?'completed':submitError?'failed':submitted?'pending':'failed';\nreturn {json:{...j,success,status,error:success?'':submitError||'Confirmación de pertenencia pendiente',result:{profile_id:j.profile_id,request_accepted:submitted,membership_confirmed:success}}};"
      }
    },
