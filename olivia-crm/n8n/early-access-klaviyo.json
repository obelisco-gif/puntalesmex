    {
      "id": "51122294-5184-4aa6-8b11-81ae746956e4",
      "name": "Reclamar trabajo Klaviyo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        224
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "select public.olivia_claim_integration('klaviyo_early_access') as job union all select public.olivia_claim_integration('klaviyo_unsubscribe') as job;"
      }
    },
    {
      "id": "efb9e2e1-59c9-4e86-85ed-3624ccb59988",
      "name": "Desempaquetar trabajo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        224
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j=$json.job;\nif(!j?.job_id)return [];\nconst attributes={email:j.email,external_id:j.contact_id};\nif(j.first_name)attributes.first_name=j.first_name;\nif(/^\\+[1-9][0-9]{6,14}$/.test(j.phone??'')) attributes.phone_number=j.phone;\nif(j.kind==='klaviyo_early_access') attributes.properties={bf2026_early_access:true,bf2026_source:'sadiet_crm'};\nreturn {json:{...j,profile_body:{data:{type:'profile',attributes}}}};"
      }
    },
    {
      "id": "49c0c864-6f78-439d-9d1d-eb0a51d4f247",
      "name": "Crear o actualizar perfil Klaviyo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        224
      ],
      "parameters": {
        "method": "POST",
        "url": "https://a.klaviyo.com/api/profile-import?additional-fields%5Bprofile%5D=subscriptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "application/vnd.api+json"
            },
            {
              "name": "revision",
              "value": "2026-10-15"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.profile_body }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "57b069f0-c503-4e4a-b316-18b6e590223c",
      "name": "Validar permiso y estado remoto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        224
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j=$('Desempaquetar trabajo').item.json;\nconst ok=[200,201].includes($json.statusCode);\nconst profile=$json.body?.data;\nconst marketing=profile?.attributes?.subscriptions?.email?.marketing??{};\nconst remoteAt=Date.parse(marketing.consent_timestamp??marketing.last_updated??'');\nconst localAt=Date.parse(j.consent_at??'');\nconst revoked=marketing.consent==='UNSUBSCRIBED'&&(!Number.isFinite(remoteAt)||remoteAt>=localAt);\nconst suppressed=(Array.isArray(marketing.suppression)?marketing.suppression:[]).some(x=>['SPAM_REPORT','HARD_BOUNCE','USER_SUPPRESSED'].includes(String(x.reason??x.suppression_reason??'').toUpperCase()));\nconst blocked=!ok||(j.kind==='klaviyo_early_access'&&(revoked||suppressed));\nreturn {json:{...j,profile_id:profile?.id??'',blocked,is_unsubscribe:j.kind==='klaviyo_unsubscribe',already_requested:j.job_payload?.request_accepted===true,error:!ok?'No se pudo actualizar el perfil':revoked?'Baja remota posterior o de fecha desconocida':suppressed?'Perfil suprimido: revisión manual':'',subscribe_body:{data:{type:'profile-subscription-bulk-create-job',attributes:{custom_source:'Sadiet BF2026 · formulario/CRM',profiles:{data:[{type:'profile',attributes:{email:j.email,subscriptions:{email:{marketing:{consent:'SUBSCRIBED'}}}}}]}},relationships:{list:{data:{type:'list',id:j.list_id}}}}},unsubscribe_body:{data:{type:'profile-subscription-bulk-delete-job',attributes:{profiles:{data:[{type:'profile',attributes:{email:j.email,subscriptions:{email:{marketing:{consent:'UNSUBSCRIBED'}}}}}]}}}}}};"
      }
    },
    {
      "id": "9b6ebbba-fdd9-4d4f-88f2-e47cd27cc9cb",
      "name": "¿Bloqueado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1120,
        224
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.blocked }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "8706461c-978b-4dcc-9ef7-a53b06048ddb",
      "name": "Preparar bloqueo",
