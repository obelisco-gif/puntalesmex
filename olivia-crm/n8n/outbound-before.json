        "jsCode": "const pending=$('Desempaquetar envío').item.json;\nif(!pending.dispatch_id) throw new Error('Falta dispatch_id: no registrar un envío sin correlación');\nconst external_id=$json.messages?.[0]?.id??null;\nconst err=$json.error;\nconst error=external_id?null:String(err?.message??err??'Sin identificador de envío; revisar antes de reintentar').slice(0,1500);\nreturn {json:{dispatch_id:pending.dispatch_id,external_id,error}};"
